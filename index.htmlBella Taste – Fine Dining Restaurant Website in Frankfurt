<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bella Taste | Fine Dining Frankfurt</title>

<meta name="description" content="Bella Taste — elegant dining, delicious cuisine and a memorable experience in Frankfurt, Germany.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>

:root{
    --black:#0d0d0d;
    --card:#171717;
    --gold:#d4af37;
    --light:#f5f5f5;
    --muted:#a5a5a5;
    --border:rgba(212,175,55,.22);
    --heading:'Cormorant Garamond',serif;
    --body:'Montserrat',sans-serif;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    background:var(--black);
    color:var(--light);
    font-family:var(--body);
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:18px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(13,13,13,.96);
    border-bottom:1px solid var(--border);
}

.logo{
    font-family:var(--heading);
    font-size:2rem;
    font-weight:700;
    color:var(--gold);
    letter-spacing:2px;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
}

.nav-links a{
    font-size:.85rem;
    text-transform:uppercase;
    letter-spacing:1px;
}

.nav-links a:hover{
    color:var(--gold);
}

.hamburger{
    display:none;
    background:none;
    border:0;
    color:var(--gold);
    font-size:1.5rem;
}

.hero{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:100px 20px;
    background:
    linear-gradient(rgba(0,0,0,.72),rgba(0,0,0,.78)),
    url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1920&q=80")
    center/cover no-repeat;
}

.hero-content{
    max-width:850px;
}

.location{
    color:var(--gold);
    text-transform:uppercase;
    letter-spacing:3px;
    font-size:.9rem;
}

.hero h1{
    font-family:var(--heading);
    color:var(--gold);
    font-size:5.5rem;
    line-height:1;
    margin:20px 0;
}

.hero p{
    font-size:1.15rem;
    color:#eee;
    margin-bottom:30px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:13px 28px;
    border-radius:4px;
    text-transform:uppercase;
    font-size:.8rem;
    font-weight:600;
    letter-spacing:1.5px;
    display:inline-block;
}

.btn-gold{
    background:linear-gradient(135deg,#d4af37,#aa820a);
    color:#000;
}

.btn-outline{
    border:1px solid var(--gold);
    color:var(--gold);
}

.btn-outline:hover{
    background:var(--gold);
    color:#000;
}

section{
    padding:100px 8%;
}

.section-title{
    text-align:center;
    margin-bottom:50px;
}

.section-title span{
    color:var(--muted);
    text-transform:uppercase;
    letter-spacing:2px;
    font-size:.8rem;
}

.section-title h2{
    font-family:var(--heading);
    color:var(--gold);
    font-size:3rem;
}

.divider{
    width:60px;
    height:2px;
    background:var(--gold);
    margin:15px auto;
}

.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:55px;
    align-items:center;
}

.about img{
    width:100%;
    border:1px solid var(--border);
}

.about h2{
    font-family:var(--heading);
    color:var(--gold);
    font-size:3rem;
    margin-bottom:20px;
}

.about p{
    color:var(--muted);
    margin-bottom:20px;
}

.services{
    background:var(--card);
}

.service-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.service{
    text-align:center;
    padding:40px 25px;
    background:var(--black);
    border:1px solid var(--border);
}

.service i{
    color:var(--gold);
    font-size:2.5rem;
    margin-bottom:20px;
}

.service h3{
    font-family:var(--heading);
    font-size:1.6rem;
    margin-bottom:10px;
}

.service p{
    color:var(--muted);
}

.menu-tabs{
    text-align:center;
    margin-bottom:40px;
}

.tab{
    padding:10px 18px;
    margin:5px;
    background:none;
    color:white;
    border:1px solid var(--border);
    cursor:pointer;
    border-radius:4px;
}

.tab.active,
.tab:hover{
    background:var(--gold);
    color:#000;
}

.menu-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
}

.menu-item{
    display:flex;
    justify-content:space-between;
    gap:20px;
    padding-bottom:18px;
    border-bottom:1px dashed var(--border);
}

.menu-item.hidden{
    display:none;
}

.menu-item h3{
    font-family:var(--heading);
    font-size:1.45rem;
}

.menu-item p{
    color:var(--muted);
    font-size:.85rem;
}

.price{
    color:var(--gold);
    font-family:var(--heading);
    font-size:1.4rem;
    font-weight:bold;
}

.gallery{
    background:var(--card);
}

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.gallery img{
    width:100%;
    height:250px;
    object-fit:cover;
    border:1px solid var(--border);
    transition:.3s;
}

.gallery img:hover{
    transform:scale(1.03);
}

.reviews{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
}

.review{
    background:var(--card);
    padding:30px;
    border:1px solid var(--border);
}

.stars{
    color:var(--gold);
    margin-bottom:15px;
}

.review p{
    color:var(--muted);
    font-style:italic;
    margin-bottom:15px;
}

.review h4{
    font-family:var(--heading);
}

.contact{
    background:var(--card);
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
}

.contact-info div{
    display:flex;
    gap:15px;
    margin-bottom:25px;
}

.contact-info i{
    color:var(--gold);
    font-size:1.3rem;
}

.contact-info p{
    color:var(--muted);
}

form input,
form textarea{
    width:100%;
    padding:14px;
    margin-bottom:15px;
    background:var(--black);
    border:1px solid var(--border);
    color:white;
    border-radius:4px;
    font-family:var(--body);
}

form textarea{
    height:140px;
    resize:vertical;
}

form button{
    width:100%;
    border:0;
    cursor:pointer;
}

.map{
    width:100%;
    height:250px;
    margin-top:20px;
}

.map iframe{
    width:100%;
    height:100%;
    border:0;
}

footer{
    padding:45px 8% 25px;
    text-align:center;
    border-top:1px solid var(--border);
}

.social{
    display:flex;
    justify-content:center;
    gap:18px;
    margin-bottom:20px;
}

.social a{
    width:42px;
    height:42px;
    border:1px solid var(--border);
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    color:var(--gold);
}

.copy{
    color:var(--muted);
    font-size:.8rem;
}

.whatsapp{
    position:fixed;
    right:25px;
    bottom:25px;
    width:58px;
    height:58px;
    border-radius:50%;
    background:#25d366;
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:1.8rem;
    z-index:999;
}

@media(max-width:900px){

    .hamburger{
        display:block;
    }

    .nav-links{
        position:absolute;
        top:70px;
        right:-100%;
        width:100%;
        height:calc(100vh - 70px);
        background:var(--black);
        flex-direction:column;
        justify-content:center;
        align-items:center;
        transition:.3s;
    }

    .nav-links.active{
        right:0;
    }

    .about,
    .contact-grid,
    .menu-grid{
        grid-template-columns:1fr;
    }

    .service-grid,
    .reviews{
        grid-template-columns:1fr;
    }

    .gallery-grid{
        grid-template-columns:1fr 1fr;
    }

    .hero h1{
        font-size:3.8rem;
    }
}

@media(max-width:600px){

    section{
        padding:75px 6%;
    }

    .hero h1{
        font-size:3rem;
    }

    .hero p{
        font-size:1rem;
    }

    .section-title h2{
        font-size:2.4rem;
    }

    .gallery-grid{
        grid-template-columns:1fr;
    }

    .gallery img{
        height:230px;
    }
}

</style>
</head>

